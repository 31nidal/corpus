# Sans configuration : Study utilise son moteur local ; chat et flashcards gardent leur provider indépendant.
# Endpoint d'un adaptateur qui respecte le contrat documenté dans server/README.md.
CHAT_UPSTREAM_URL=
CHAT_UPSTREAM_TOKEN=
PORT=4173

# Génération pédagogique uniquement côté serveur (jamais de préfixe VITE_).
# Une clé configurée sélectionne Gemini ; "local" désactive les appels payants.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# AI_GENERATION_PROVIDER=gemini
# GEMINI_TIMEOUT_MS=45000
# GEMINI_CONCURRENCY=2
# AI_DAILY_REQUEST_LIMIT=200
# AI_DAILY_BUDGET_USD=1
# Estimation standard USD / million de tokens, à adapter au contrat Google.
# GEMINI_INPUT_USD_PER_MILLION=0.30
# GEMINI_OUTPUT_USD_PER_MILLION=2.50

# Lancement initial : pas d'API payante, pas d'Ollama, pas de GPU ni de quota Study consommé.
STUDY_AI_PROVIDER=local

# Réactivation ultérieure d'Ollama, uniquement si explicitement configuré :
# STUDY_AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT_MS=120000

# Provider distant payant, uniquement si explicitement configuré :
# STUDY_AI_PROVIDER=remote

# Comptes : facultatif en local. Railway utilise son volume monté automatiquement.
# ACCOUNT_DATA_DIR=.data
# APP_ORIGIN=https://mycorpus3d.com

# Connexion Google (facultative). Ces valeurs restent exclusivement côté serveur.
# Créer un client OAuth 2.0 de type « Application Web » et déclarer exactement :
# https://mycorpus3d.com/api/account/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://mycorpus3d.com/api/account/google/callback
